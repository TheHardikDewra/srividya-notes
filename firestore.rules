rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each user can read/write only their own per-app progress doc.
    // Shared by all sadhana apps: shodashi-ashtottara, lalita-sahasranama,
    // lalita-trishati, shri-rudram, vishnu-sahasranama-stotram, bala-sadhana
    // and srividya-notes (appId = the doc id under /apps). The wildcard means
    // a new app needs no rules change - only a new appId in its config.
    match /users/{uid}/apps/{appId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
